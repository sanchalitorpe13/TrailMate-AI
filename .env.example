# Ollama server address (default local install)
TRAILMATE_OLLAMA_URL=http://localhost:11434
# Model used for mission generation
TRAILMATE_OLLAMA_MODEL=gemma3:4b
# Seconds to wait for the model before falling back
TRAILMATE_OLLAMA_TIMEOUT=90
# SQLite file location (relative paths are inside the project folder)
TRAILMATE_DB_PATH=data/trailmate.db